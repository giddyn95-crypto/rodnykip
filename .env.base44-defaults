# Base44 dev defaults — placeholders so the app boots before credentials land.
# Real values are delivered by the platform to /run/base44/app.env (listed after
# this file in compose env_file, so they always win).

# Deriv app id — drives OAuth login/sign-up and WebSocket connections.
# Empty here keeps the app rendering with login disabled until you provide one.
NEXT_PUBLIC_DERIV_APP_ID=

# Google Drive integration (optional; leave blank to disable).
GD_CLIENT_ID=
GD_APP_ID=
GD_API_KEY=
